    "udp-port-wrap.php": "<?php\nrequire '/home/coder/Asyncara/autoload.php';\nAsyncara\\Async::run(function () {\n    $a = new Asyncara\\IO\\UdpSocket(); $b = new Asyncara\\IO\\UdpSocket();\n    try {\n        $port = (int)substr(strrchr($b->address(), ':'), 1);\n        $invalid = '127.0.0.1:' . ($port + 65536);\n        $a->send('must-not-send', $invalid);\n        $received = Asyncara\\Async::timeout(1, $b->receive(...));\n        echo json_encode(['invalidDestination'=>$invalid,'actualDestination'=>$b->address(),'received'=>$received]),\"\\n\";\n    } finally { $a->close(); $b->close(); }\n});\n",
    "udp-resolver-probe.c": "#define _GNU_SOURCE\n#include <dlfcn.h>\n#include <errno.h>\n#include <netdb.h>\n#include <string.h>\n#include <time.h>\n#include <unistd.h>\nint getaddrinfo(const char *node, const char *service, const struct addrinfo *hints, struct addrinfo **result) {\n    if (node && !strcmp(node, \"deadbeef\")) {\n        const char marker[] = \"UDP_SYNCHRONOUS_RESOLVER_ENTERED\\n\";\n        if (write(STDERR_FILENO, marker, sizeof(marker)-1) < 0) return EAI_SYSTEM;\n        struct timespec delay = {.tv_sec=0,.tv_nsec=200000000};\n        while (nanosleep(&delay,&delay)<0 && errno==EINTR) {}\n        *result=NULL;return EAI_NONAME;\n    }\n    int (*next)(const char *,const char *,const struct addrinfo *,struct addrinfo **)=dlsym(RTLD_NEXT,\"getaddrinfo\");\n    if (!next) { errno=ENOSYS;return EAI_SYSTEM; }\n    return next(node,service,hints,result);\n}\n",
    "udp-resolver-control.php": "<?php\nrequire '/home/coder/Asyncara/autoload.php';\nAsyncara\\Async::run(function () {\n    $socket = new Asyncara\\IO\\UdpSocket(); $ticks=0;\n    $timer=Asyncara\\Async::spawn(function () use (&$ticks) { for($i=0;$i<5;$i++){Asyncara\\Async::sleep(.01);$ticks++;} });\n    $start=hrtime(true);\n    try { $socket->send('probe','[deadbeef]:12345'); }\n    catch (Throwable $e) { echo json_encode(['error'=>get_class($e),'elapsedNs'=>hrtime(true)-$start,'ticksAtError'=>$ticks]),\"\\n\"; }\n    finally { $socket->close(); }\n    $timer->await();\n});\n"
